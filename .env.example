# ==============================================================================
# SUPABASE CONFIGURATION
# Obtain these from your Supabase Project Settings -> API
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Keep this strictly private, never share or commit)
# Used for server-side elevated admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Authentication credentials (Keep private in Vercel / server environment)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-admin-password

# Public Site URL (for SEO, OpenGraph and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
